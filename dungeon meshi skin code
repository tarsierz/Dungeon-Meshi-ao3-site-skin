html:before {
  background-image: url("https://i.postimg.cc/52pwdFXr/laios-stamp.png");
  background-repeat: no-repeat;
  background-position: bottom right;
  background-size: contain;
  width: 150px;
  height: 150px;
  content: "";
  position: fixed;
  bottom: 0px;
  right: 0px;
  z-index: 1000;
  opacity: 1;
}

.commas li:has(a.tag,
a[data-remote="true"]),
.commas li a.tag {
  margin: unset;
  padding: unset;
  border: unset;
  line-height: 1.4;
  font-size: 105%;
}

.commas li::after {
  content: none;
}

.commas:has(a.tag,
a[data-remote="true"]) {
  display: inline-flex;
  flex-wrap: wrap;
  column-gap: 6px;
  align-items: center;
}

.tag.home .listbox .tags.commas {
  width: 100%;
}

.commas li a.tag,
.tags a[data-remote="true"] {
  display: inline-block;
  margin-block: 3px;
  padding: 0.15em 0.6em;
  border: 2px solid #444;
  border-radius: 12px;
  background-color: #E4E4E4;
  color: #111111;
  font-weight: 600;
  text-decoration: none;
  text-shadow: none;
}

div:has(.commas) [class^="warning"] a.tag,
.tags .warnings a[data-remote="true"] {
  border-color: #990000;
  background-color: #FFD6D6;
  color: #111111;
}

div:has(.commas) [class^="relationship"] a.tag,
div:has(.commas) [class^="relationship"] a.tag[href*="%20*a*%20"] {
  border-color: #994D00;
  background-color: #FFD9B2;
  color: #111111;
}

div:has(.commas) [class^="character"] a.tag {
  border-color: #8A7500;
  background-color: #FFF4A8;
  color: #111111;
}

div:has(.commas) [class^="freeform"] a.tag,
.tags .freeforms a[data-remote="true"] {
  border-color: #2F6B13;
  background-color: #D9F5C8;
  color: #111111;
}

.rating.tags a.tag {
  border-color: #BF1960;
  background-color: #FFD4E6;
  color: #111111;
}

.category.tags a.tag {
  border-color: #3A5485;
  background-color: #D6DAF5;
  color: #111111;
}

.fandom.tags a.tag {
  border-color: #006699;
  background-color: #D0F4FF;
  color: #111111;
}

div:has(.commas) a.tag:is(:hover,
:focus),
div:has(.commas) a.tag[href*="*"]:is(:hover,
:focus),
.commas.tags a[data-remote="true"]:is(:hover,
:focus) {
  border-color: #FFFFFF;
  background-color: #7A0000;
  color: #FFFFFF;
}

div:has(.commas) a.tag:focus-visible {
  outline: 3px solid #7a2cff;
  outline-offset: 2px;
}

